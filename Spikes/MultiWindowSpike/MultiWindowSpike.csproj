<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Common settings (target framework, language level, style enforcement, CI-strict warnings)
         come from the repo-root Directory.Build.props. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>MultiWindowSpike</RootNamespace>
    <AssemblyName>MultiWindowSpike</AssemblyName>
    <!-- Throwaway spike: its warning set is frozen in place (no one owes it a cleanup pass),
         unlike the shipped projects which must build warning-free. -->
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The exact OpenTK version Vocaluxe ships with (Vocaluxe/Vocaluxe.csproj: OpenTK 4.9.4), so the
         spike validates the same GLFW/NativeWindow API surface (SharedContext, Monitors, events) the
         production refactor will use. -->
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

</Project>
