<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MultiWindowSpike</RootNamespace>
    <AssemblyName>MultiWindowSpike</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The exact OpenTK version Vocaluxe ships with (Vocaluxe/Vocaluxe.csproj: OpenTK 4.9.4), so the
         spike validates the same GLFW/NativeWindow API surface (SharedContext, Monitors, events) the
         production refactor will use. -->
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

</Project>
