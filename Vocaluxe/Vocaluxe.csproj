<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WinExe = Windows GUI subsystem: no console window pops up on launch (the game window is the UI).
         On Linux/macOS WinExe is treated identically to Exe, so this stays cross-platform. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Vocaluxe</RootNamespace>
    <AssemblyName>Vocaluxe</AssemblyName>
    <StartupObject>Vocaluxe.CMainProgram</StartupObject>
    <ApplicationIcon>Vocaluxe.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Properties/AssemblyInfo.cs is kept from the original project; the version attributes in it
         were replaced by the _StampGitVersion target below. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The legacy SSIS-Remote layout: the app builds into the repo's Output/ folder, right next to the
         game data (Themes, Languages, Fonts, ...) that already lives there - same as the net48 build. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\Output\</OutputPath>
    <!-- Land the exe + managed + native assemblies directly in Output/ (not Output/net10.0/), next to
         the game data (Themes, Fonts, Languages, Config.xml, libs/unmanaged) that lives at the Output/
         root. ProgramFolder = AppDomain.BaseDirectory, so the app resolves data relative to the exe. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- One cross-platform codebase: OpenGL everywhere (OpenTK 4) + PortAudio, no WinForms/Direct3D.
         The WIN/LINUX symbol is chosen per build OS so the same sources compile correctly on each
         platform. ARCH_X64 selects the 64-bit native-interop paths. -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">WIN;ARCH_X64</DefineConstants>
    <DefineConstants Condition="!$([MSBuild]::IsOSPlatform('Windows'))">LINUX;ARCH_X64</DefineConstants>
    <!-- macOS is a non-Windows platform, so it also gets LINUX (the shared Unix/OpenGL/PortAudio
         paths). MACOS is defined additionally so genuinely Linux-only code can opt out with
         '#if LINUX && !MACOS'. -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);MACOS</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0649;CS0169;CS0414;CS0162;CA1416;NU1701</NoWarn>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <!-- macOS publishes need the SkiaSharp dylib from the macOS native-asset package; only pulled in
         when building on/for macOS so the Linux/Windows builds are unaffected. -->
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- CCloud's HTTP stack (IHttpClientFactory + Polly resilience), same versions as the net48 build. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.0" />
    <PackageReference Include="Polly" Version="8.2.0" />
    <!-- Native-only bundles (FFmpeg 4.x + acinerella shim + SQLite) that place their binaries under
         libs/unmanaged, exactly like the old packages.config build did. -->
    <PackageReference Include="vocaluxe.dependencies.acinerella" Version="1.0.6" />
    <PackageReference Include="vocaluxe.dependencies.ffmpeg" Version="1.0.6" />
    <PackageReference Include="vocaluxe.dependencies.csharpsqlite" Version="1.0.1" />
    <PackageReference Include="vocaluxe.dependencies.sqlite" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
    <ProjectReference Include="..\Community.CsharpSqlite\Community.CsharpSqlite.csproj" />
  </ItemGroup>

  <!-- Ship the application icon next to the exe: CAppIcon decodes it at startup into the NativeWindow
       icon (the standard cross-platform way - the largest 256x256 image of Vocaluxe.ico). On Windows
       the exe ALSO embeds it via ApplicationIcon above, which CWindowsIcon reads for the task-bar class
       icon. PreserveNewest re-stages the ico whenever it is swapped (e.g. for a newer export of
       icon.svg). A Vocaluxe.png dropped next to it is picked up as a fallback at runtime, no rebuild needed. -->
  <ItemGroup>
    <Content Include="Vocaluxe.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Stamp the assembly version from `git describe` at build time. Replaces the old MSBuild build
       events (winPreBuild.ps1 / linuxPreBuildEvent.sh) that the .NET Framework project ran but the
       SDK project does not. git is optional: if it is unavailable (e.g. a source tarball) the build
       falls back to the "Not Versioned" strings instead of failing. -->
  <Target Name="_StampGitVersion" BeforeTargets="CoreCompile">
    <Exec Command="git describe --tags --long --always --dirty" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>
    <PropertyGroup>
      <_Versioned Condition="'$(_GitExit)' == '0' and '$(_GitRaw)' != ''">true</_Versioned>
      <_Arch Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">$(Platform)</_Arch>
      <_Arch Condition="'$(_Arch)' == ''">x64</_Arch>

      <_Informational Condition="'$(_Versioned)' == 'true'">$(_GitRaw)</_Informational>
      <_Tag Condition="'$(_Versioned)' == 'true'">$([System.Text.RegularExpressions.Regex]::Match($(_GitRaw), `^[^-]+`).Value)</_Tag>
      <!-- First DOTTED numeric run in the tag, e.g. "0.4.1" (a leading `v` like `v0.4.1` is tolerated; no `^`
           anchor). Requires at least one dot so a bare commit hash (git describe falls back to the hash on a
           tagless/shallow checkout, e.g. "4117979a") is not mined for digits: "4117979" would exceed the
           65534 AssemblyVersion-component limit and fail with CS7034. No match then falls back to 0.0.0. -->
      <_Numeric Condition="'$(_Versioned)' == 'true'">$([System.Text.RegularExpressions.Regex]::Match($(_Tag), `[0-9]+(\.[0-9]+)+`).Value)</_Numeric>
      <_Title Condition="'$(_Versioned)' == 'true'">Vocaluxe $(_Tag) ($(_Arch)) ($(_GitRaw))</_Title>

      <_Informational Condition="'$(_Versioned)' != 'true'">0.0.0-na-notversioned</_Informational>
      <_Title Condition="'$(_Versioned)' != 'true'">Vocaluxe 'Not Versioned' 0.0.0 (NA) (0.0.0-na-notversioned)</_Title>

      <_Numeric Condition="'$(_Numeric)' == ''">0.0.0</_Numeric>
    </PropertyGroup>
    <ItemGroup>
      <_VerAttr Include="System.Reflection.AssemblyTitleAttribute">
        <_Parameter1>$(_Title)</_Parameter1>
      </_VerAttr>
      <_VerAttr Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(_Informational)</_Parameter1>
      </_VerAttr>
      <_VerAttr Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(_Numeric)</_Parameter1>
      </_VerAttr>
      <_VerAttr Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(_Numeric)</_Parameter1>
      </_VerAttr>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(_VerAttr)" Language="C#"
                       OutputDirectory="$(IntermediateOutputPath)" OutputFile="GitVersion.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>

  <!-- Stage every unmanaged native the game needs next to the other libs in Output/libs/unmanaged.
       Sources:
         - vocaluxe.dependencies.* NuGet packages ship their binaries in a plain x64/ folder with
           build targets keyed on Platform=='x64', which net10 SDK builds never set (Platform=AnyCPU)
           - so nothing gets copied on a fresh checkout without this (the old Output/ copies were
           net48-era relics).
         - PitchTracker: the sibling C++ vcxproj. Build it first (Visual Studio 2022+ with the C++
           workload):  msbuild PitchTracker\PitchTracker.vcxproj /p:Configuration=Release /p:Platform=x64
       A missing native is a hard error on Windows - never ship a game that would die on first
       decode/record/DB use. On non-Windows the natives come from the makefiles, so this is skipped. -->
  <Target Name="_StageUnmanagedNatives" BeforeTargets="Build;Publish">
    <PropertyGroup>
      <_UnmanagedDst>$(MSBuildThisFileDirectory)..\Output\libs\unmanaged</_UnmanagedDst>
      <_PkgRoot>$(NuGetPackageRoot)</_PkgRoot>
      <_PtDir>$(MSBuildThisFileDirectory)..\PitchTracker\bin\Release.x64</_PtDir>
      <_MissingNatives Condition="!Exists('$(_PkgRoot)vocaluxe.dependencies.acinerella\1.0.6\x64\acinerella.dll')">acinerella; $(_MissingNatives)</_MissingNatives>
      <_MissingNatives Condition="!Exists('$(_PkgRoot)vocaluxe.dependencies.ffmpeg\1.0.6\x64\avcodec-58.dll')">ffmpeg; $(_MissingNatives)</_MissingNatives>
      <_MissingNatives Condition="!Exists('$(_PkgRoot)vocaluxe.dependencies.sqlite\1.0.1\build\net40\x64\SQLite.Interop.dll')">sqlite; $(_MissingNatives)</_MissingNatives>
      <_MissingNatives Condition="!Exists('$(_PtDir)\PitchTracker.dll')">PitchTracker (build see header); $(_MissingNatives)</_MissingNatives>
    </PropertyGroup>
    <ItemGroup>
      <_UnmanagedNative Include="$(_PkgRoot)vocaluxe.dependencies.acinerella\1.0.6\x64\*.dll" />
      <_UnmanagedNative Include="$(_PkgRoot)vocaluxe.dependencies.acinerella\1.0.6\x64\*.pdb" />
      <_UnmanagedNative Include="$(_PkgRoot)vocaluxe.dependencies.ffmpeg\1.0.6\x64\*.dll" />
      <_UnmanagedNative Include="$(_PkgRoot)vocaluxe.dependencies.sqlite\1.0.1\build\net40\x64\SQLite.Interop.dll" />
      <_UnmanagedNative Include="$(_PtDir)\PitchTracker.dll" />
      <_UnmanagedNative Include="$(_PtDir)\PitchTracker.pdb" />
    </ItemGroup>
    <Error Condition="'$(OS)' == 'Windows_NT' and '$(_MissingNatives)' != ''"
           Text="Missing unmanaged native(s): $(_MissingNatives) - run 'dotnet restore', and build PitchTracker Release x64 (see _StageUnmanagedNatives header)." />
    <Copy Condition="'$(OS)' == 'Windows_NT'"
          SourceFiles="@(_UnmanagedNative)"
          DestinationFolder="$(_UnmanagedDst)" SkipUnchangedFiles="true" />
  </Target>

  <!-- After the PortAudioSharp2 runtime package has laid its stock portaudio.dll down, replace
        every copy in Output/ with our ASIO-capable build (Native\portaudio-asio, see BUILD.md
        there). All wrapper entry points are exported (verified), so this is a pure native swap:
        the C# audio layer is unchanged, stock hosts (MME/WASAPI/DirectSound) keep working as
        before and ASIO clients appear as additional devices (multichannel + ~1.3 ms buffers).
        Overwriting the app-dir copy AND the runtimes\ asset keeps every loader path in
        agreement; libs\unmanaged is on the game's PATH (Program.cs) and gets the same dll. -->
  <Target Name="_StagePaAsioNative" AfterTargets="Build;Publish" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_PaAsioSrc>$(MSBuildThisFileDirectory)..\Native\portaudio-asio\win-x64\portaudio.dll</_PaAsioSrc>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PaAsioSrc)')"
           Text="Missing Native\portaudio-asio\win-x64\portaudio.dll - rebuild it (Native\portaudio-asio\build.ps1) or restore the committed binary." />
    <Copy SourceFiles="$(_PaAsioSrc)" DestinationFiles="$(MSBuildThisFileDirectory)..\Output\portaudio.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_PaAsioSrc)" DestinationFiles="$(MSBuildThisFileDirectory)..\Output\runtimes\win-x64\native\portaudio.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_PaAsioSrc)" DestinationFiles="$(MSBuildThisFileDirectory)..\Output\libs\unmanaged\portaudio.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
