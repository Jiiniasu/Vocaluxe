<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Common settings (target framework, language level, style enforcement, CI-strict warnings,
         platform define constants) come from the repo-root Directory.Build.props. -->
    <!-- WinExe = Windows GUI subsystem: no console window pops up on launch (the game window is the UI).
         On Linux/macOS WinExe is treated identically to Exe, so this stays cross-platform. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Vocaluxe</RootNamespace>
    <AssemblyName>Vocaluxe</AssemblyName>
    <StartupObject>Vocaluxe.CMainProgram</StartupObject>
    <ApplicationIcon>Vocaluxe.ico</ApplicationIcon>
    <!-- CFFmpegDecoder (the modern FFmpeg decoder replacing acinerella) uses managed pointers
         into the FFmpeg structs - the same approach as the upstream port. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The legacy SSIS-Remote layout: the app builds into the repo's Output/ folder, right next to the
         game data (Themes, Languages, Fonts, ...) that already lives there - same as the net48 build. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\Output\</OutputPath>
    <!-- Land the exe + managed + native assemblies directly in Output/ (not Output/net10.0/), next to
         the game data (Themes, Fonts, Languages, Config.xml, libs/unmanaged) that lives at the Output/
         root. ProgramFolder = AppDomain.BaseDirectory, so the app resolves data relative to the exe. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- FFmpeg API bindings for CFFmpegDecoder (the acinerella replacement): managed, dynamically
         loaded, pinned to the FFmpeg 8.1 ABI (avcodec-62 / avutil-60). The 8.1.3 GPL shared
         binaries are staged next to the exe under libs/unmanaged/ffmpeg64 (see the staging
         target and FFmpeg-Modernization-Plan.md). MIT-licensed (Ruslan-B/FFmpeg.AutoGen); the
         upstream .NET 10 port (Vocaluxe/Vocaluxe#946) uses the same version. -->
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="8.1.0" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="8.1.0" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
    <!-- macOS publishes need the SkiaSharp dylib from the macOS native-asset package; only pulled in
          when building on/for macOS so the Linux/Windows builds are unaffected. -->
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.154.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <!-- CCloud's HTTP retry (v7-compatible API surface, v8 package). -->
    <PackageReference Include="Polly" Version="8.9.0" />
    <!-- SQLite on the official Microsoft.Data.Sqlite provider. Its native engine (SQLitePCLRaw
          "e_sqlite3") ships as runtimes/<rid>/native assets and resolves next to the exe in
          Output/ - no manual staging target needed for it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
  </ItemGroup>

  <!-- Ship the application icon next to the exe: CAppIcon decodes it at startup into the NativeWindow
        icon (the standard cross-platform way - the largest 256x256 image of Vocaluxe.ico). On Windows
        the exe ALSO embeds it via ApplicationIcon above, which CWindowsIcon reads for the task-bar class
        icon. PreserveNewest re-stages the ico whenever it is swapped (e.g. for a newer export of
        icon.svg). A Vocaluxe.png dropped next to it is picked up as a fallback at runtime, no rebuild needed. -->
   <ItemGroup>
    <Content Include="Vocaluxe.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Stamp the assembly version from `git describe` at build time. Replaces the old MSBuild build
        events (winPreBuild.ps1 / linuxPreBuildEvent.sh) that the .NET Framework project ran but the
        SDK project does not. git is optional: if it is unavailable (e.g. a source tarball) the build
        falls back to the "Not Versioned" strings instead of failing. -->
   <Target Name="_StampGitVersion" BeforeTargets="CoreCompile">
    <Exec Command="git describe --tags --long --always --dirty" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>
    <PropertyGroup>
      <_Versioned Condition="'$(_GitExit)' == '0' and '$(_GitRaw)' != ''">true</_Versioned>
      <_Arch Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">$(Platform)</_Arch>
      <_Arch Condition="'$(_Arch)' == ''">x64</_Arch>

      <_Informational Condition="'$(_Versioned)' == 'true'">$(_GitRaw)</_Informational>
      <_Tag Condition="'$(_Versioned)' == 'true'">$([System.Text.RegularExpressions.Regex]::Match($(_GitRaw), `^[^-]+`).Value)</_Tag>
      <!-- First DOTTED numeric run in the tag, e.g. "0.4.1" (a leading `v` like `v0.4.1` is tolerated; no `^`
            anchor). Requires at least one dot so a bare commit hash (git describe falls back to the hash on a
            tagless/shallow checkout, e.g. "4117979a") is not mined for digits: "4117979" would exceed the
            65534 AssemblyVersion-component limit and fail with CS7034. No match then falls back to 0.0.0. -->
      <_Numeric Condition="'$(_Versioned)' == 'true'">$([System.Text.RegularExpressions.Regex]::Match($(_Tag), `[0-9]+(\.[0-9]+)+`).Value)</_Numeric>
      <_Title Condition="'$(_Versioned)' == 'true'">Vocaluxe $(_Tag) ($(_Arch)) ($(_GitRaw))</_Title>

      <_Informational Condition="'$(_Versioned)' != 'true'">0.0.0-na-notversioned</_Informational>
      <_Title Condition="'$(_Versioned)' != 'true'">Vocaluxe 'Not Versioned' 0.0.0 (NA) (0.0.0-na-notversioned)</_Title>

      <_Numeric Condition="'$(_Numeric)' == ''">0.0.0</_Numeric>
    </PropertyGroup>
    <ItemGroup>
      <_VerAttr Include="System.Reflection.AssemblyTitleAttribute">
        <_Parameter1>$(_Title)</_Parameter1>
      </_VerAttr>
      <_VerAttr Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(_Informational)</_Parameter1>
      </_VerAttr>
      <_VerAttr Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(_Numeric)</_Parameter1>
      </_VerAttr>
      <_VerAttr Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(_Numeric)</_Parameter1>
      </_VerAttr>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(_VerAttr)" Language="C#" OutputDirectory="$(IntermediateOutputPath)" OutputFile="GitVersion.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>

  <!-- Build PitchTracker.dll automatically, so a fresh checkout can no longer fail _StageUnmanagedNatives.
        A plain `dotnet build` cannot compile the sibling C++ vcxproj: its $(VCTargetsPath) targets only
        load in the Visual Studio MSBuild engine (the SDK's engine fails with MSB4278). Rather than keep
        "run msbuild PitchTracker\PitchTracker.vcxproj ... first" as a manual prerequisite - exactly how
        a missing native gets reported - locate the VS MSBuild with vswhere, which ships with every
        VS/Build Tools install and is version-/PATH-independent, then build Release|x64. The vcxproj build
        is incremental, so a warm build pays only a quick up-to-date check. Windows-only by design: on
        Linux the same contract is the makefile + _CheckLinuxNatives. -->
   <UsingTask TaskName="_FindVsMsBuild" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <MsBuildPath Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Code>
        string dir = Environment.GetEnvironmentVariable("ProgramFiles(x86)");
        if (string.IsNullOrEmpty(dir))
        {
          Log.LogError("Building PitchTracker.vcxproj needs Visual Studio (or Build Tools) with the 'Desktop development with C++' workload.");
          return false;
        }
        string vswhere = System.IO.Path.Combine(dir, @"Microsoft Visual Studio\Installer\vswhere.exe");
        if (!System.IO.File.Exists(vswhere))
        {
          Log.LogError("vswhere not found at {0}; install Visual Studio (or Build Tools), then rebuild.", vswhere);
          return false;
        }
        ProcessStartInfo psi = new ProcessStartInfo(vswhere, @"-latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe")
        {
          RedirectStandardOutput = true,
          UseShellExecute = false
        };
        Process proc = Process.Start(psi);
        string found = (proc == null) ? "" : proc.StandardOutput.ReadToEnd().Trim();
        int exit = -1;
        if (proc != null)
        {
          proc.WaitForExit();
          exit = proc.ExitCode;
        }
        if (exit != 0 || string.IsNullOrEmpty(found) || !System.IO.File.Exists(found))
        {
          Log.LogError("vswhere found no Visual Studio MSBuild to build PitchTracker.vcxproj - install the 'Desktop development with C++' workload, then rebuild.");
          return false;
        }
        MsBuildPath = found;
      </Code>
    </Task>
   </UsingTask>
   <Target Name="_BuildPitchTrackerNative" BeforeTargets="_StageUnmanagedNatives" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_PtProj>$(MSBuildThisFileDirectory)..\PitchTracker\PitchTracker.vcxproj</_PtProj>
    </PropertyGroup>
    <_FindVsMsBuild>
      <Output TaskParameter="MsBuildPath" PropertyName="_VsMsBuild" />
    </_FindVsMsBuild>
    <Exec Command='&quot;$(_VsMsBuild)&quot; "$(_PtProj)" /p:Configuration=Release /p:Platform=x64 /v:minimal /nologo' />
   </Target>

  <!-- Stage every unmanaged native the game needs next to the other libs in Output/libs/unmanaged.
        Source:
          - PitchTracker: the sibling C++ vcxproj, built automatically by _BuildPitchTrackerNative above
            (the SDK MSBuild engine cannot compile C++ - MSB4278 on $(VCTargetsPath) - so the Visual
            Studio MSBuild that vswhere finds builds Release|x64 first; that is the only prerequisite).
        (FFmpeg is staged separately by the _StageFFmpeg* targets below; portaudio by _StagePaAsioNative.)
        A missing native is a hard error on Windows - never ship a game that would die on first
        decode/record/DB use. On Linux the check is _CheckLinuxNatives' job; on macOS the RID
        packages carry the natives. -->
   <Target Name="_StageUnmanagedNatives" BeforeTargets="Build;Publish">
    <PropertyGroup>
      <_UnmanagedDst>$(MSBuildThisFileDirectory)..\Output\libs\unmanaged</_UnmanagedDst>
      <_PtDir>$(MSBuildThisFileDirectory)..\PitchTracker\bin\Release.x64</_PtDir>
      <_MissingNatives Condition="!Exists('$(_PtDir)\PitchTracker.dll')">PitchTracker (build see header); $(_MissingNatives)</_MissingNatives>
    </PropertyGroup>
    <ItemGroup>
      <_UnmanagedNative Include="$(_PtDir)\PitchTracker.dll" />
      <_UnmanagedNative Include="$(_PtDir)\PitchTracker.pdb" />
    </ItemGroup>
    <Error Condition="'$(OS)' == 'Windows_NT' and '$(_MissingNatives)' != ''" Text="Missing unmanaged native(s): $(_MissingNatives) - a missing PitchTracker means _BuildPitchTrackerNative could not run (Visual Studio / Build Tools with the C++ workload are required)." />
    <Copy Condition="'$(OS)' == 'Windows_NT'" SourceFiles="@(_UnmanagedNative)" DestinationFolder="$(_UnmanagedDst)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Stage the pinned FFmpeg 8.1.3 GPL shared build (the acinerella-era 4.x bundle replacement) under
        Output/libs/unmanaged/ffmpeg64 - the exact folder CFFmpegDecoder probes on every platform. The
        zip (VocaluxeDependencies) is pinned to the FFmpeg 8.1 ABI (avcodec-62) that the FFmpeg.AutoGen
        8.1.0 bindings require. Already staged (avcodec-62 present) = no-op, so warm builds stay offline.
        A missing result is a hard error on Windows - never ship a game that dies on first decode. -->
    <Target Name="_StageFFmpegWindows" BeforeTargets="Build;Publish" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_FFmpegDst>$(MSBuildThisFileDirectory)..\Output\libs\unmanaged</_FFmpegDst>
      <_FFmpegUrl>https://github.com/Vocaluxe/VocaluxeDependencies/raw/master/zips/dependencies/ffmpeg_x64.zip</_FFmpegUrl>
      <_FFmpegDownload Condition="!Exists('$(_FFmpegDst)\ffmpeg64\avcodec-62.dll')">true</_FFmpegDownload>
    </PropertyGroup>
    <Message Text="FFmpeg 8.1.3 is missing - downloading $(_FFmpegUrl)" Importance="high" Condition="'$(_FFmpegDownload)' == 'true'" />
    <DownloadFile Condition="'$(_FFmpegDownload)' == 'true'" SourceUrl="$(_FFmpegUrl)" DestinationFolder="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)" DestinationFileName="ffmpeg_x64.zip" />
    <Unzip Condition="'$(_FFmpegDownload)' == 'true'" SourceFiles="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)ffmpeg_x64.zip" DestinationFolder="$(_FFmpegDst)" />
    <Error Condition="!Exists('$(_FFmpegDst)\ffmpeg64\avcodec-62.dll')" Text="FFmpeg 8.1.3 (avcodec-62) missing in Output\libs\unmanaged\ffmpeg64 - the download from VocaluxeDependencies failed; check the network and rebuild." />
  </Target>

  <!-- Linux: the same pinned bundle, once the ffmpeg_linux_x64.zip artifact exists in VocaluxeDependencies
        (tracked in FFmpeg-Modernization-Plan.md P2). Until then the download is best-effort: warn loudly
        and keep the build green, because CFFmpegDecoder falls back to a system FFmpeg 8.x when the staged
        set is absent. The zip root is "ffmpeg64" so it lands in libs/unmanaged/ffmpeg64, as on Windows. -->
    <Target Name="_StageFFmpegLinux" BeforeTargets="Build;Publish" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_FFmpegDst>$(MSBuildThisFileDirectory)../Output/libs/unmanaged</_FFmpegDst>
      <_FFmpegUrl>https://github.com/Vocaluxe/VocaluxeDependencies/raw/master/zips/dependencies/ffmpeg_linux_x64.zip</_FFmpegUrl>
      <_FFmpegDownload Condition="!Exists('$(_FFmpegDst)/ffmpeg64/libavutil.so.60')">true</_FFmpegDownload>
    </PropertyGroup>
    <Message Text="FFmpeg 8.1.3 bundle missing for Linux - trying $(_FFmpegUrl)" Importance="high" Condition="'$(_FFmpegDownload)' == 'true'" />
    <DownloadFile Condition="'$(_FFmpegDownload)' == 'true'" ContinueOnError="WarnAndContinue" SourceUrl="$(_FFmpegUrl)" DestinationFolder="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)" DestinationFileName="ffmpeg_linux_x64.zip" />
    <Unzip Condition="'$(_FFmpegDownload)' == 'true' and Exists('$(MSBuildThisFileDirectory)$(IntermediateOutputPath)ffmpeg_linux_x64.zip')" SourceFiles="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)ffmpeg_linux_x64.zip" DestinationFolder="$(_FFmpegDst)" />
    <Message Importance="high" Text="WARNING: no FFmpeg 8.1.3 bundle in Output/libs/unmanaged/ffmpeg64 - CFFmpegDecoder will fall back to a system FFmpeg 8.x (see FFmpeg-Modernization-Plan.md P2 for the pinned artifact)." Condition="!Exists('$(_FFmpegDst)/ffmpeg64/libavutil.so.60')" />
  </Target>

  <!-- Linux parity for the Windows "never ship without natives" contract. The NuGet package natives
        (portaudio, SkiaSharp, SQLite, GLFW) need no staging: the SDK copies the runtimes/&lt;rid&gt;/native
        assets into the build output even for a plain no-RID `dotnet build`, and the runtime probes
        Output/runtimes/linux-x64/native for every DllImport. PitchTracker is the exception - it is
        built from local sources by the makefile (see the root makefile) and is not checked in, so on a
        fresh checkout the game would build fine and die at startup with a DllNotFoundException. Gate the
        build instead, and point at the fix. (FFmpeg's Linux bundle is staged best-effort by
        _StageFFmpegLinux until the pinned artifact is published - see FFmpeg-Modernization-Plan.md P2.) -->
  <Target Name="_CheckLinuxNatives" BeforeTargets="Build;Publish" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\Output\libPitchTracker.dll.so')" Text="Missing Output\libPitchTracker.dll.so - run 'make -C PitchTracker' first (see the root makefile)." />
  </Target>

  <!-- After the PortAudioSharp2 runtime package has laid its stock portaudio.dll down, replace
        every copy in Output/ with our ASIO-capable build (Native\portaudio-asio, see BUILD.md
        there). All wrapper entry points are exported (verified), so this is a pure native swap:
        the C# audio layer is unchanged, stock hosts (MME/WASAPI/DirectSound) keep working as
        before and ASIO clients appear as additional devices (multichannel + ~1.3 ms buffers).
        Overwriting the app-dir copy AND the runtimes\ asset keeps every loader path in
        agreement; libs\unmanaged is on the game's PATH (Program.cs) and gets the same dll. -->
   <Target Name="_StagePaAsioNative" AfterTargets="Build;Publish" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_PaAsioSrc>$(MSBuildThisFileDirectory)..\Native\portaudio-asio\win-x64\portaudio.dll</_PaAsioSrc>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PaAsioSrc)')" Text="Missing Native\portaudio-asio\win-x64\portaudio.dll - rebuild it (Native\portaudio-asio\build.ps1) or restore the committed binary." />
    <Copy SourceFiles="$(_PaAsioSrc)" DestinationFiles="$(MSBuildThisFileDirectory)..\Output\portaudio.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_PaAsioSrc)" DestinationFiles="$(MSBuildThisFileDirectory)..\Output\runtimes\win-x64\native\portaudio.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_PaAsioSrc)" DestinationFiles="$(MSBuildThisFileDirectory)..\Output\libs\unmanaged\portaudio.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
