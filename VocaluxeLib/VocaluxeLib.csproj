<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Common settings (target framework, language level, style enforcement, CI-strict warnings,
         platform define constants) come from the repo-root Directory.Build.props: the WIN/LINUX
         symbols are shared with Vocaluxe.csproj on purpose - the library has #if WIN code the game
         references, so both must agree on the platform define. -->
    <OutputType>Library</OutputType>
    <RootNamespace>VocaluxeLib</RootNamespace>
    <AssemblyName>VocaluxeLib</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.TextWriter" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Log\CLogFunctions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CLogFunctions.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
